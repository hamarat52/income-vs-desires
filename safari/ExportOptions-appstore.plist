<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  App Store Connect icin YEREL export (yukleme YOK: destination=export).
  macOS ve iOS arsivleri icin ortak. Gerekli sertifikalar:
    - iOS:   Apple Distribution
    - macOS: Apple Distribution + Mac Installer Distribution (.pkg imzasi)
  Kullanim (safari/IncomeVsDesires dizininden):
    xcodebuild -exportArchive -archivePath build/IVD-macOS.xcarchive \
      -exportOptionsPlist ../ExportOptions-appstore.plist \
      -exportPath build/export-macOS -allowProvisioningUpdates
    xcodebuild -exportArchive -archivePath build/IVD-iOS.xcarchive \
      -exportOptionsPlist ../ExportOptions-appstore.plist \
      -exportPath build/export-iOS -allowProvisioningUpdates
-->
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>teamID</key>
	<string>28TVDBBT3G</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
